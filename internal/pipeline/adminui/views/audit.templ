package views

import "fmt"

templ Audit(page AuditPage) { @Layout("Audit", "audit", page.Shell, AuditContent(page)) }
templ AuditContent(page AuditPage) {
	<section id="audit-fragment" aria-live="polite"><h1>Audit log</h1>
	if page.Error != "" {
		<p class="notice error" role="alert">{ page.Error }</p>
	} else if len(page.Items)==0 {
		<p class="empty">No audit events.</p>
	} else {
		<div class="table-wrap"><table><caption>Append-only operator and system events</caption><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Reason</th><th>Candidate</th><th>Job</th><th>Revision</th></tr></thead><tbody>
		for _, item := range page.Items {
			<tr><td><time>{ FormatTime(item.OccurredAt) }</time></td><td>{ item.Actor }</td><td>{ item.Action }</td><td>{ item.Reason }</td><td class="mono">{ item.CandidateID }</td><td class="mono">{ item.JobID }</td><td class="mono">
				if item.Revision != nil {
					{ fmt.Sprint(*item.Revision) }
				}
			</td></tr>
		}
		</tbody></table></div>
	}
	</section>
}
