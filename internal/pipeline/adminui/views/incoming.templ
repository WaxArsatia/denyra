package views

import "fmt"

templ Incoming(page IncomingPage) {
	@Layout("Incoming", "incoming", page.Shell, IncomingContent(page))
}

templ IncomingContent(page IncomingPage) {
	<section id="incoming-fragment" aria-live="polite"><h1>Manual incoming</h1><p class="muted">Upload discovery never starts processing. Submit seals the current tree.</p>
		if page.Error != "" {
			<p class="notice error" role="alert">{ page.Error }</p>
		} else if len(page.Items) == 0 {
			<p class="empty">No manual upload folders discovered.</p>
		} else {
			<div class="table-wrap"><table><caption>Discovered manual submissions</caption><thead><tr><th>Submission</th><th>Path</th><th>Status</th><th>Revision</th><th>Fingerprint</th><th>Action</th></tr></thead><tbody>
			for _, item := range page.Items {
				<tr><td class="mono">{ item.ID }</td><td class="mono">{ item.SourcePath }</td><td><span class="status">{ item.Status }</span></td><td class="mono">{ fmt.Sprint(item.Revision) }</td><td class="checksum">{ item.SealedFingerprint }</td><td><form method="post" action={ templ.SafeURL("/incoming/" + item.ID + "/submit") }><input type="hidden" name="_csrf" value={ page.Shell.CSRFToken }/><input type="hidden" name="state_revision" value={ fmt.Sprint(item.Revision) }/><button type="submit">Submit</button></form></td></tr>
			}
			</tbody></table></div>
		}
	</section>
}
