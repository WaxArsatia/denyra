package views

import (
	"fmt"

	"github.com/waxarsatia/denyra/internal/pipeline/application"
)

templ MigrationDetail(page MigrationPage) {
	@Layout("Migration batch", "unmanaged", page.Shell, MigrationDetailContent(page))
}

templ MigrationDetailContent(page MigrationPage) {
	<section id="migration-content" hx-get={ templ.SafeURL("/migration-batches/" + page.Detail.ID) } hx-trigger="migration-batch-changed from:body" hx-target="#migration-content" hx-swap="outerHTML">
		@MigrationBatchBody(page)
		@MigrationStatusFragment(page.Detail.ID, page.Status)
	</section>
}

templ MigrationStatusFragment(batchID string, status application.MigrationBatchStatus) {
	if status.Active > 0 {
		<div id="migration-batch-status" class="muted" hx-get={ templ.SafeURL(fmt.Sprintf("/migration-batches/%s/status?revision=%d", batchID, status.Revision)) } hx-trigger="every 5s" hx-swap="outerHTML"><span>{ fmt.Sprintf("Active %d", status.Active) }</span> · <span>{ fmt.Sprintf("Completed %d", status.Completed) }</span> · <span>{ fmt.Sprintf("Failed %d", status.Failed) }</span></div>
	} else {
		<div id="migration-batch-status" class="muted"><span>{ fmt.Sprintf("Active %d", status.Active) }</span> · <span>{ fmt.Sprintf("Completed %d", status.Completed) }</span> · <span>{ fmt.Sprintf("Failed %d", status.Failed) }</span></div>
	}
}

templ MigrationBatchBody(page MigrationPage) {
	<h1>Migration batch</h1>
	<dl class="evidence"><dt>Batch</dt><dd class="mono">{ page.Detail.ID }</dd><dt>Requested by</dt><dd>{ page.Detail.Actor }</dd><dt>State</dt><dd><span class="status">{ page.Detail.State }</span></dd><dt>Created</dt><dd><time>{ FormatTime(page.Detail.CreatedAt) }</time></dd></dl>
	if page.Error != "" {
		<div class="notice error" role="alert">{ page.Error }</div>
	}
	<div class="table-wrap"><table><caption>Independent album results</caption><thead><tr><th scope="col">Confirm</th><th scope="col">Album artist</th><th scope="col">Album</th><th scope="col">Result</th><th scope="col">MusicBrainz release</th><th scope="col">Details</th></tr></thead><tbody>
		for _, item := range page.Detail.Items {
			<tr><td>
				if item.State == "EXACT_MATCH" {
					<input form="confirm-migrations" type="checkbox" name="item_id" value={ item.ID } aria-label={ "Confirm " + item.Album }/>
				}
			</td><td>{ item.AlbumArtist }</td><td>{ item.Album }</td><td><span class={ "status " + StateClass(item.State) }>{ MigrationStateLabel(item.State) }</span></td><td class="mono">{ item.CandidateMBID }</td><td class="wrap">
				if item.State == "FAILED_RETRYABLE" {
					{ item.Error }
					<form method="post" action={ templ.SafeURL("/migration-items/" + item.ID + "/retry") }><input type="hidden" name="_csrf" value={ page.Shell.CSRFToken }/><input type="hidden" name="batch_id" value={ page.Detail.ID }/><input type="hidden" name="state_revision" value={ fmt.Sprint(item.Revision) }/><button type="submit">Retry</button></form>
				}
			</td></tr>
		}
	</tbody></table></div>
	<form id="confirm-migrations" class="stack confirm migration-confirm" method="post" action={ templ.SafeURL("/migration-batches/" + page.Detail.ID + "/confirm") }><input type="hidden" name="_csrf" value={ page.Shell.CSRFToken }/>
		for _, item := range page.Detail.Items {
			if item.State == "EXACT_MATCH" {
				<input type="hidden" name={ "state_revision_" + item.ID } value={ fmt.Sprint(item.Revision) }/><input type="hidden" name={ "release_mbid_" + item.ID } value={ item.CandidateMBID }/>
			}
		}
		<label class="inline-check"><input type="checkbox" name="confirm_migrations" value="yes" required/> I reviewed the exact matches and want to migrate the selected albums.</label><button class="primary" type="submit">Confirm selected migrations</button>
	</form>
}
